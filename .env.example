# ==============================================================================
#  CAPUCCINO VAINILLA — Conector Odoo ⇄ WooCommerce
#  PLANTILLA: copiá este archivo a ".env" y completá con credenciales reales.
#      cp .env.example .env        (Linux/macOS)
#      copy .env.example .env      (Windows)
#  ⚠️  NUNCA subas el archivo .env real al control de versiones.
# ==============================================================================

# ------------------------------------------------------------------------------
#  ODOO ENTERPRISE (XML-RPC)            [obligatorio]
# ------------------------------------------------------------------------------
ODOO_URL=https://capuccino-vainilla.odoo.com
ODOO_DB=capuccino_vainilla
ODOO_USERNAME=integraciones@pinnacle.com
# Recomendado: API Key en vez del password (Ajustes > Usuarios > Seguridad de la cuenta).
ODOO_PASSWORD=tu_api_key_de_odoo

# ------------------------------------------------------------------------------
#  WOOCOMMERCE (REST API v3)            [obligatorio]
#  Generar claves: WooCommerce > Ajustes > Avanzado > REST API (Lectura/Escritura)
# ------------------------------------------------------------------------------
WOO_URL=https://tienda.capuccinovainilla.com
WOO_CONSUMER_KEY=ck_xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
WOO_CONSUMER_SECRET=cs_xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
WOO_API_VERSION=wc/v3
# Poné "false" SOLO en entornos de desarrollo locales (certificados self-signed).
WOO_VERIFY_SSL=true
HTTP_TIMEOUT=30                # Timeout (s) de las llamadas HTTP a WooCommerce

# ------------------------------------------------------------------------------
#  WEBHOOK (servidor de pedidos WooCommerce -> Odoo)            [opcional]
#  El secreto debe coincidir con el configurado en el webhook de WooCommerce.
#  Generá uno fuerte:  openssl rand -hex 32   (o  python -c "import secrets;print(secrets.token_hex(32))")
# ------------------------------------------------------------------------------
WEBHOOK_SECRET=cambiar_por_un_secreto_largo_y_aleatorio
WEBHOOK_PATH=/webhooks/woocommerce/orders
WEBHOOK_HOST=0.0.0.0
WEBHOOK_PORT=8000

# ------------------------------------------------------------------------------
#  RUNTIME (sincronización)            [opcional, con defaults]
# ------------------------------------------------------------------------------
BATCH_SIZE=50                 # Tamaño de lote para la paginación
MAX_RETRIES=3                 # Reintentos ante fallos de API
RETRY_DELAY=2                 # Demora base (s) entre reintentos (backoff exponencial)
LOG_LEVEL=INFO                # DEBUG | INFO | WARNING | ERROR
LOG_FILE=logs/sync.log        # Log con rotación (dir escribible en host y contenedor)
STATE_FILE=.sync_state.json   # Estado para sincronización incremental

# ------------------------------------------------------------------------------
#  WATCHER (sincronización automática del catálogo)            [opcional]
# ------------------------------------------------------------------------------
WATCH_INTERVAL=30                     # Segundos entre ciclos del watcher (> 0)
WATCH_INITIAL_FULL=true               # Primer arranque: reconciliar todo el catálogo
WATCH_STATE_FILE=.watch_snapshot.json # Snapshot de huellas (incremental)
