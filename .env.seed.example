# ==============================================================================
#  SEED ODOO -> ODOO  (copia de productos del Odoo real al Odoo local)
#  PLANTILLA: copiá este archivo a ".env.seed" y completá.
#      cp .env.seed.example .env.seed        (Linux/macOS)
#      copy .env.seed.example .env.seed      (Windows)
#  ⚠️  NUNCA subas el archivo .env.seed real al control de versiones.
# ==============================================================================

# ------------------------------------------------------------------------------
#  ORIGEN: Odoo real de la empresa (SOLO LECTURA)            [obligatorio]
#  Usá idealmente una API Key de un usuario de solo lectura.
# ------------------------------------------------------------------------------
ODOO_SRC_URL=https://capuccino-vainilla.odoo.com
ODOO_SRC_DB=capuccino_vainilla
ODOO_SRC_USERNAME=integraciones@pinnacle.com
ODOO_SRC_PASSWORD=tu_api_key_de_odoo

# ------------------------------------------------------------------------------
#  DESTINO: Odoo local en Docker (acá se escribe)            [obligatorio]
# ------------------------------------------------------------------------------
ODOO_DST_URL=http://localhost:8069
ODOO_DST_DB=capuccino_test
ODOO_DST_USERNAME=admin
ODOO_DST_PASSWORD=admin
