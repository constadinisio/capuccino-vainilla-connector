# ==============================================================================
#  ENTORNO DE PRUEBA LOCAL — Validación end-to-end (NO es producción)
#  PLANTILLA: copiá este archivo a ".env.local" y completá las credenciales.
#      cp .env.test.example .env.local        (Linux/macOS)
#      copy .env.test.example .env.local      (Windows)
#  La CLI lo usa con:  capuccino-vainilla --env-file .env.local <comando>
#  ⚠️  Todo debe apuntar a localhost / a la COPIA de prueba, NUNCA a producción.
# ==============================================================================

# ------------------------------------------------------------------------------
#  ODOO: la COPIA de la productiva, nunca la real            [obligatorio]
# ------------------------------------------------------------------------------
ODOO_URL=https://odoo.gpinnacle.com
ODOO_DB=pinnacle_test
ODOO_USERNAME=integraciones@pinnacle.com
ODOO_PASSWORD=tu_api_key_de_odoo

# ------------------------------------------------------------------------------
#  WOOCOMMERCE local (Docker)            [obligatorio]
#  Completá ck_/cs_ con la API Key que genera el setup de prueba.
# ------------------------------------------------------------------------------
WOO_URL=http://localhost:8080
WOO_CONSUMER_KEY=ck_completar_tras_provisioning
WOO_CONSUMER_SECRET=cs_completar_tras_provisioning
WOO_API_VERSION=wc/v3
WOO_VERIFY_SSL=false           # local sin TLS válido
HTTP_TIMEOUT=30

# ------------------------------------------------------------------------------
#  WEBHOOK (Flujo 2)            [opcional]
#  Debe coincidir con el secreto configurado en el webhook de WooCommerce.
# ------------------------------------------------------------------------------
WEBHOOK_SECRET=secreto_de_prueba_largo_y_aleatorio
WEBHOOK_PATH=/webhooks/woocommerce/orders
WEBHOOK_HOST=0.0.0.0
WEBHOOK_PORT=8000

# ------------------------------------------------------------------------------
#  RUNTIME            [opcional, con defaults]
# ------------------------------------------------------------------------------
BATCH_SIZE=50
MAX_RETRIES=3
RETRY_DELAY=2
LOG_LEVEL=DEBUG
LOG_FILE=sync-test.log
STATE_FILE=.sync_state.test.json

# ------------------------------------------------------------------------------
#  WATCHER            [opcional]
# ------------------------------------------------------------------------------
WATCH_INTERVAL=30
WATCH_INITIAL_FULL=true
WATCH_STATE_FILE=.watch_snapshot.test.json
